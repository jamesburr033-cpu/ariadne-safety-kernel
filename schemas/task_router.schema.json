{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ariadne Task Router Decision",
  "type": "object",
  "required": [
    "intent",
    "risk",
    "approval_required",
    "recommended_workflow",
    "allowed_tools",
    "blocked_actions",
    "confidence"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "code_patch",
        "test_run",
        "status_check",
        "file_search",
        "documentation",
        "risky_machine_action",
        "unclear"
      ]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "blocked"]
    },
    "approval_required": {
      "type": "boolean"
    },
    "recommended_workflow": {
      "type": "string"
    },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocked_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
